{
  "source": "C:\\Users\\Administrator\\Documents\\xwechat_files\\wxid_p1ysrxe840qm22_7bce\\temp\\RWTemp\\2026-10\\8c3d7da3482a84e1b080e99000347640\\序幕至第七章-逐句中文演出剧本-合订本(1).md",
  "sha256": "6df4294c10a7a5dd7364aa4246fbdc1554bb91692ca0c0797c71f39548229fc4",
  "turns": [
    {
      "id": "序-001",
      "actor": "室友",
      "original": "你那盏灯还不关？我都睡醒一小觉了，睁眼看见你还坐在那里，以为天亮了。",
      "gameLine": 1
    },
    {
      "id": "序-002",
      "actor": "陆川",
      "original": "就剩这一页。我不是没做完，主要是这份解析写得有点绕，想看看它究竟绕在哪里。",
      "gameLine": 2
    },
    {
      "id": "序-003",
      "actor": "室友",
      "original": "你的答案都对了，还跟解析较劲？换我早把书合上了。",
      "gameLine": 3
    },
    {
      "id": "序-004",
      "actor": "陆川",
      "original": "做对是一回事，别人拿一段话把我说服是另一回事。要是我只是运气好，下次换个问法，还得再碰一次运气。",
      "gameLine": 4
    },
    {
      "id": "序-005",
      "actor": "室友",
      "original": "行，那你替我也研究一下，为什么明天第一节课不能晚半小时。",
      "gameLine": 5
    },
    {
      "id": "序-006",
      "actor": "陆川",
      "original": "这个问题已经超出教材范围，不过你可以写封信给排课老师，我帮你检查语法。",
      "gameLine": 6
    },
    {
      "id": "序-007",
      "actor": "室友",
      "original": "不用了，帮我带两个包子比较实际。钱明早给你，我真的睡了。",
      "gameLine": 7
    },
    {
      "id": "序-008",
      "actor": "陆川",
      "original": "记住是明早给。上回你说月底，我等到的只有月亮。",
      "gameLine": 8
    },
    {
      "id": "序-009",
      "actor": "旁白",
      "original": "床帘里传来一声含糊的答应。陆川笑了一下，把空杯挪到桌角，重新看向屏幕。",
      "gameLine": 9
    },
    {
      "id": "序-010",
      "actor": "陆川",
      "original": "好了，这页看完就关灯，明天总不能靠跟老师争论来补觉。",
      "gameLine": 10
    },
    {
      "id": "序-011",
      "actor": "屏幕文字",
      "original": "If a door can open, it must also lead somewhere.",
      "gameLine": 11
    },
    {
      "id": "序-012",
      "actor": "屏幕字幕",
      "original": "如果一扇门能够打开，它也应当通向某处。",
      "gameLine": 12
    },
    {
      "id": "序-013",
      "actor": "陆川",
      "original": "这不是题库里的内容吧……我没打开别的网站，怎么还弹出来一段英文？",
      "gameLine": 13
    },
    {
      "id": "序-014",
      "actor": "旁白",
      "original": "屏幕映出一扇窗。陆川回头，身后只有室友的床帘，窗的位置是一面墙。",
      "gameLine": 14
    },
    {
      "id": "序-015",
      "actor": "陆川",
      "original": "等等，别动。我先拔电——",
      "gameLine": 15
    },
    {
      "id": "序-016",
      "actor": "陆川",
      "original": "我刚才明明还在桌前。这个地方没有墙，也没有地板的边……有人能听见吗？",
      "gameLine": 16
    },
    {
      "id": "序-017",
      "actor": "伊瑟雅",
      "original": "能听见，陆川。先放松手，你不用抓得那么紧，你的身体没有受伤。",
      "gameLine": 17
    },
    {
      "id": "序-018",
      "actor": "陆川",
      "original": "你知道我的名字。那也应该知道，我不是自己走进这里的。你能先告诉我发生了什么吗？",
      "gameLine": 18
    },
    {
      "id": "序-019",
      "actor": "伊瑟雅",
      "original": "我是伊瑟雅，守护艾瑟兰大陆地脉联系的女神。刚才的白光，是我发起的召唤。",
      "gameLine": 19
    },
    {
      "id": "序-020",
      "actor": "陆川",
      "original": "女神……这解释比停电严重很多。我应该先行礼，还是先问你能不能把我送回去？",
      "gameLine": 20
    },
    {
      "id": "序-021",
      "actor": "伊瑟雅",
      "original": "先问你最关心的事。这里不需要你为了说话而跪下。",
      "gameLine": 21
    },
    {
      "id": "序-022",
      "actor": "陆川",
      "original": "那我直接问。我能回去吗？我的家人、同学都还在那边，我只是在复习，没有准备离开。",
      "gameLine": 22
    },
    {
      "id": "序-023",
      "actor": "伊瑟雅",
      "original": "能，但不是现在。原有的归途经过大陆地脉，如今通路受到了污染，强行送你回去可能伤害你。",
      "gameLine": 23
    },
    {
      "id": "序-024",
      "actor": "陆川",
      "original": "送我来时为什么可以？如果同一条路有危险，来和回总该有个区别。",
      "gameLine": 24
    },
    {
      "id": "序-025",
      "actor": "伊瑟雅",
      "original": "我用仅存的跨界力量建立了一次单向召唤，将你带到这个交界处。它没有足够的力量再反向开启，也不能继续召来第二个人。",
      "gameLine": 25
    },
    {
      "id": "序-026",
      "actor": "陆川",
      "original": "所以你把最后这一次用在了我身上。接下来大概不是请我帮忙翻译一封信吧？",
      "gameLine": 26
    },
    {
      "id": "序-027",
      "actor": "伊瑟雅",
      "original": "我需要你前往艾瑟兰，帮助那里的人，最终击败魔王瓦尔莫斯。",
      "gameLine": 27
    },
    {
      "id": "序-028",
      "actor": "陆川",
      "original": "我会读英文，不会挥剑。你要是看过我上一次体育课，应该会重新考虑这个选择。",
      "gameLine": 28
    },
    {
      "id": "序-029",
      "actor": "伊瑟雅",
      "original": "我没有把你的语言能力误认为剑术。你能理解复杂的咒句，也愿意追问规则是否合理，这些才是我需要的。",
      "gameLine": 29
    },
    {
      "id": "序-030",
      "actor": "陆川",
      "original": "这些听起来还不足以跟魔王打架。你从头讲吧，至少让我知道自己要面对什么。",
      "gameLine": 30
    },
    {
      "id": "序-031",
      "actor": "伊瑟雅",
      "original": "大陆中央有一座古老遗迹，叫无声之庭。它原本让城镇矿脉、森林、海岸、陨坑和地下岩层的力量彼此协调。",
      "gameLine": 31
    },
    {
      "id": "序-032",
      "actor": "伊瑟雅",
      "original": "八十年前，瓦尔莫斯占据遗迹，在旧建筑上增修了蚀冠堡垒。他把原本供各地流动的力量，改成只流向王座。",
      "gameLine": 32
    },
    {
      "id": "序-033",
      "actor": "陆川",
      "original": "他占到的不是一座城堡，是能影响整片大陆的东西。",
      "gameLine": 33
    },
    {
      "id": "序-034",
      "actor": "伊瑟雅",
      "original": "是。他用那些力量改造野兽、兵器和岩石，制造服从命令的魔物。每占下一处地区，就能再扩大自己的军队。",
      "gameLine": 34
    },
    {
      "id": "序-035",
      "actor": "伊瑟雅",
      "original": "村庄被烧毁，城镇被侵占。人们逃向邻近的地方，却发现那里的路也被封住，土地越少，能得到的粮食和援军也越少。",
      "gameLine": 35
    },
    {
      "id": "序-036",
      "actor": "陆川",
      "original": "当时的国王没有办法阻止他？",
      "gameLine": 36
    },
    {
      "id": "序-037",
      "actor": "伊瑟雅",
      "original": "奥德里克二世组织过抵抗，但普通军队无法持续对抗魔物。国王麾下最强的魔术师赛维恩，耗尽毕生积累，铸造了五颗宝石。",
      "gameLine": 37
    },
    {
      "id": "序-038",
      "actor": "伊瑟雅",
      "original": "金曜、木曜、水曜、火曜和土曜。他将它们分别交给五位将军，使他们获得足以对抗魔王的魔力。",
      "gameLine": 38
    },
    {
      "id": "序-039",
      "actor": "陆川",
      "original": "五个人就能扭转整场战争？还是他们带着军队一起做到了？",
      "gameLine": 39
    },
    {
      "id": "序-040",
      "actor": "伊瑟雅",
      "original": "他们带着军队。十年里有很多人负责运粮、修路和救治，将军们也不能在缺少支援的时候一直战斗。",
      "gameLine": 40
    },
    {
      "id": "序-041",
      "actor": "伊瑟雅",
      "original": "十年后，他们收复失地，将瓦尔莫斯封印在蚀冠堡垒最深处。但各地制造魔物的核心还在，不能只封住魔王就离开。",
      "gameLine": 41
    },
    {
      "id": "序-042",
      "actor": "伊瑟雅",
      "original": "五位将军回到五处地区，把各自的宝石深埋在核心旁，压住污染，形成围绕遗迹的五重封锁。",
      "gameLine": 42
    },
    {
      "id": "序-043",
      "actor": "陆川",
      "original": "那是七十年前。如今出问题，是因为宝石的力量用尽了？",
      "gameLine": 43
    },
    {
      "id": "序-044",
      "actor": "伊瑟雅",
      "original": "正在用尽。宝石需要恢复和维护，赛维恩却在最后的安置完成后去世，许多方法没能完整传下去。",
      "gameLine": 44
    },
    {
      "id": "序-045",
      "actor": "伊瑟雅",
      "original": "现在，森林里的动物会突然发狂，码头夜间出现逆潮，矿洞里响起不属于矿工的敲击声。人们还把它们当成互不相干的灾害。",
      "gameLine": 45
    },
    {
      "id": "序-046",
      "actor": "陆川",
      "original": "你希望我找到宝石，恢复它们，再利用它们打败魔王。我理解了目标，但步骤听起来仍有很多空白。",
      "gameLine": 46
    },
    {
      "id": "序-047",
      "actor": "伊瑟雅",
      "original": "你说得对。我知道赛维恩留下过复原方案，也知道五路交汇处的归灯驿站曾是维护节点，但我不知道全部操作步骤和记录的位置。",
      "gameLine": 47
    },
    {
      "id": "序-048",
      "actor": "陆川",
      "original": "我宁可听到你说不知道，也不想到了危险地方才发现保证不算数。取走宝石，不会让当地封锁直接失效吗？",
      "gameLine": 48
    },
    {
      "id": "序-049",
      "actor": "伊瑟雅",
      "original": "不能直接取。要先停止制造核心，找到能维持封锁的替代方法。具体图纸需要你们调查，我无法在这里替你凭空给出。",
      "gameLine": 49
    },
    {
      "id": "序-050",
      "actor": "陆川",
      "original": "你为什么不能自己进去？那片大陆不是由你守护吗？",
      "gameLine": 50
    },
    {
      "id": "序-051",
      "actor": "伊瑟雅",
      "original": "被污染的封锁隔绝了我直接进入核心的力量。我能够指引，也能授予能力，但不能替你打开每一扇门。",
      "gameLine": 51
    },
    {
      "id": "序-052",
      "actor": "陆川",
      "original": "那我会得到什么？别又只给我一本很厚的说明书。",
      "gameLine": 52
    },
    {
      "id": "序-053",
      "actor": "伊瑟雅",
      "original": "雷电。你通过吟唱引导它，语言的意思决定方向，节奏与魔力控制决定它能否准确落下。",
      "gameLine": 53
    },
    {
      "id": "序-054",
      "actor": "陆川",
      "original": "所以听懂句子只解决一半，剩下要看我能不能在紧张的时候说清楚，及时停下来。",
      "gameLine": 54
    },
    {
      "id": "序-055",
      "actor": "伊瑟雅",
      "original": "还要判断周围的水、金属、同伴的位置。英语优秀不会让你的魔力无限，也不会让每一次临场判断都正确。",
      "gameLine": 55
    },
    {
      "id": "序-056",
      "actor": "陆川",
      "original": "这点我倒是不敢反驳。我们先练一个小的吧，我还不想把第一位观众劈倒。",
      "gameLine": 56
    },
    {
      "id": "序-057",
      "actor": "伊瑟雅",
      "original": "指向那只空杯，想清楚落点。念完短咒就停止，不要因光还不够亮而继续加力。",
      "gameLine": 57
    },
    {
      "id": "序-058",
      "actor": "陆川",
      "original": "Gather here, and strike only where I guide.",
      "gameLine": 58
    },
    {
      "id": "序-059",
      "actor": "旁白",
      "original": "细小电弧击碎了杯沿。陆川猛地收手，低头看自己的指尖，确认麻意正在减轻。",
      "gameLine": 59
    },
    {
      "id": "序-060",
      "actor": "陆川",
      "original": "比我想象的真得多。这只杯子需要赔吗？我现在的钱还在宿舍裤子里。",
      "gameLine": 60
    },
    {
      "id": "序-061",
      "actor": "伊瑟雅",
      "original": "不需要。先记住刚才停止的感觉，下次环境不同，不能照搬这次的落点。",
      "gameLine": 61
    },
    {
      "id": "序-062",
      "actor": "陆川",
      "original": "我会记。雷电和五颗宝石是什么关系，我总不能一个人拿着全部武器吧？",
      "gameLine": 62
    },
    {
      "id": "序-063",
      "actor": "伊瑟雅",
      "original": "雷电不是第六颗宝石。五曜负责各自的力量，你的雷电能帮助它们短时同步，但需要持有者的配合，不是由你支配别人。",
      "gameLine": 63
    },
    {
      "id": "序-064",
      "actor": "陆川",
      "original": "也就是说，我得先认识愿意跟我做这件事的人。希望见面时，我不至于连自己的能力都解释不明白。",
      "gameLine": 64
    },
    {
      "id": "序-065",
      "actor": "伊瑟雅",
      "original": "也让他们有时间解释自己。你不是只去寻找能够使用宝石的手。",
      "gameLine": 65
    },
    {
      "id": "序-066",
      "actor": "陆川",
      "original": "这句话我听懂了。那就从有屋顶、能吃饭的地方开始，别让我第一晚先体验荒野求生。",
      "gameLine": 66
    },
    {
      "id": "序-067",
      "actor": "伊瑟雅",
      "original": "这枚罗盘会指向归灯驿站。我不能保证那里一切完好，但它仍是五路交汇的地点。",
      "gameLine": 67
    },
    {
      "id": "序-068",
      "actor": "陆川",
      "original": "看来屋顶也不在保证里面。最后再问一次，封印稳定之后，你会帮我回家？",
      "gameLine": 68
    },
    {
      "id": "序-069",
      "actor": "伊瑟雅",
      "original": "会。我将打开安全归途，是否离开由你决定，不以此要求你永久留下。",
      "gameLine": 69
    },
    {
      "id": "序-070",
      "actor": "陆川",
      "original": "好，我把它当正式约定。至于打败魔王这件事，我先去看清楚，再一步一步做。",
      "gameLine": 70
    },
    {
      "id": "序-071",
      "actor": "CG字幕",
      "original": "他还不知道怎样走完这段路，只先记住了归途的约定。",
      "gameLine": 71
    },
    {
      "id": "序-072",
      "actor": "旁白",
      "original": "雨穿过屋顶，落在一张断腿桌子上。陆川站在大厅，先抬头看见露出的梁，再听见墙下的啃咬声。",
      "gameLine": 72
    },
    {
      "id": "序-073",
      "actor": "陆川",
      "original": "……至少这里以前有屋顶。女神介绍落脚点的时候，应该把“以前”也念出来。",
      "gameLine": 73
    },
    {
      "id": "序-074",
      "actor": "旁白",
      "original": "棘背狼抬起头，木棘间沾着黑泥。陆川退到桌边，抬手的电光沿湿铜线跳动。",
      "gameLine": 74
    },
    {
      "id": "序-075",
      "actor": "艾莉娅",
      "original": "别动，把手放低。你脚边有水，铜线也连着横梁，不能直接在这里施法。",
      "gameLine": 75
    },
    {
      "id": "序-076",
      "actor": "陆川",
      "original": "我没想打到那边，我刚学会雷电……不，先告诉我站哪里比较安全。",
      "gameLine": 76
    },
    {
      "id": "序-077",
      "actor": "艾莉娅",
      "original": "退到壁炉前的干石板。我把它引开，你先说清楚落点，不要看见它扑上来就随手放。",
      "gameLine": 77
    },
    {
      "id": "序-078",
      "actor": "陆川",
      "original": "炉前右侧的空地，不靠你的脚。我用短咒，打断它准备扑咬的动作，能配合吗？",
      "gameLine": 78
    },
    {
      "id": "序-079",
      "actor": "艾莉娅",
      "original": "可以，等我给信号。还有，别站在受损横梁下，那张桌子也挡不住它。",
      "gameLine": 79
    },
    {
      "id": "序-080",
      "actor": "艾莉娅",
      "original": "它要扑了，现在！",
      "gameLine": 80
    },
    {
      "id": "序-081",
      "actor": "陆川",
      "original": "Strike where I guide!",
      "gameLine": 81
    },
    {
      "id": "序-082",
      "actor": "艾莉娅",
      "original": "先检查手臂和腿，有没有被爪子碰到？别只说没事，衣服破的地方都看一遍。",
      "gameLine": 82
    },
    {
      "id": "序-083",
      "actor": "陆川",
      "original": "没有伤口，腿倒是一直在抖。我能坐那张椅子吗，还是它也准备袭击我？",
      "gameLine": 83
    },
    {
      "id": "序-084",
      "actor": "艾莉娅",
      "original": "椅腿断了，坐炉边石阶。我是艾莉娅，边境巡防骑士，追这头狼过来的。",
      "gameLine": 84
    },
    {
      "id": "序-085",
      "actor": "陆川",
      "original": "陆川。昨天这个时候我还在大学宿舍，现在连该拿什么证明自己都不知道。",
      "gameLine": 85
    },
    {
      "id": "序-086",
      "actor": "艾莉娅",
      "original": "你是怎么进来的？附近的人都知道这间驿站荒废了，通常不会往里面走。",
      "gameLine": 86
    },
    {
      "id": "序-087",
      "actor": "陆川",
      "original": "说出来可能很像借口，女神把我送到这里。我确实没有从村口走进来，也没在路上看见这只狼。",
      "gameLine": 87
    },
    {
      "id": "序-088",
      "actor": "艾莉娅",
      "original": "我暂时不能核实女神，但你刚才的施法我看见了。其他事情等你缓过来再说，先别让自己受凉。",
      "gameLine": 88
    },
    {
      "id": "序-089",
      "actor": "陆川",
      "original": "你没有直接把我当成发烧说胡话，已经比我预想的好。刚才谢谢你，不然我可能真的会把雨水一起通电。",
      "gameLine": 89
    },
    {
      "id": "序-090",
      "actor": "艾莉娅",
      "original": "你听了落点要求，也替我打断了扑击。能配合就好，别现在又急着证明自己什么都会。",
      "gameLine": 90
    },
    {
      "id": "序-091",
      "actor": "陆川",
      "original": "我还没自信到那一步。它为什么啃铜线，旁边明明有旧食物？",
      "gameLine": 91
    },
    {
      "id": "序-092",
      "actor": "艾莉娅",
      "original": "追它一路，它不是一直找吃的。狼爪上的黑泥也不正常，我要把位置记下来，你不要直接摸。",
      "gameLine": 92
    },
    {
      "id": "序-093",
      "actor": "陆川",
      "original": "铜线上有五道刻痕，和普通接线不像。是不是以前的设施招来了它？",
      "gameLine": 93
    },
    {
      "id": "序-094",
      "actor": "艾莉娅",
      "original": "可能，但不能看一眼就下结论。天亮再查，眼下先离那根梁远一点，它在往下沉。",
      "gameLine": 94
    },
    {
      "id": "序-095",
      "actor": "陆川",
      "original": "储物间还有木板，我来搬。你如果知道怎么修，告诉我做哪一部分，我总不能一直当被救的人。",
      "gameLine": 95
    },
    {
      "id": "序-096",
      "actor": "艾莉娅",
      "original": "可以，但先撑梁，不能急着往屋顶堆东西。这根临时撑柱你扶好，我固定以后再补板。",
      "gameLine": 96
    },
    {
      "id": "序-097",
      "actor": "陆川",
      "original": "我原本想把漏雨的地方都封住，现在看先后顺序确实不能反过来。先撑住，再往上加东西，对吧？",
      "gameLine": 97
    },
    {
      "id": "序-098",
      "actor": "艾莉娅",
      "original": "对。这些只是今晚的抢修，白天还要请木匠检查。别因为雨暂时停进来，就以为整间屋子安全了。",
      "gameLine": 98
    },
    {
      "id": "序-099",
      "actor": "旁白",
      "original": "第一块补板遮住最密的雨线，剩下的漏口用油布临时压住。两人轮流扶柱、递钉，手套很快湿透。",
      "gameLine": 99
    },
    {
      "id": "序-100",
      "actor": "陆川",
      "original": "你巡防的时候，也经常修这种地方？我以为骑士最熟的工具应该是剑，不是锤子。",
      "gameLine": 100
    },
    {
      "id": "序-101",
      "actor": "艾莉娅",
      "original": "边境没那么多现成住处。下雨时找不到屋顶，就要自己处理；战斗之后也总有东西需要补。",
      "gameLine": 101
    },
    {
      "id": "序-102",
      "actor": "陆川",
      "original": "你今天原本是不是还有别的事？追狼已经够忙了，又被我拖进一夜修缮。",
      "gameLine": 102
    },
    {
      "id": "序-103",
      "actor": "艾莉娅",
      "original": "我在核查失踪巡逻队的路线。追狼过来也是调查的一部分，你不是额外拖来的麻烦，只是我没预料这里有人。",
      "gameLine": 103
    },
    {
      "id": "序-104",
      "actor": "陆川",
      "original": "那我至少负责把能递的工具递对。你饿了没有，我刚才一直没想起问。",
      "gameLine": 104
    },
    {
      "id": "序-105",
      "actor": "艾莉娅",
      "original": "有一点，先让烟道通。我把堵住的树枝清掉，试一小堆火，别马上把干柴全塞进去。",
      "gameLine": 105
    },
    {
      "id": "序-106",
      "actor": "旁白",
      "original": "烟顺着清过的烟道离开。左侧壁炉能用了，吧台后厨房的旧灶仍然积灰，两人只在炉旁烧水。",
      "gameLine": 106
    },
    {
      "id": "序-107",
      "actor": "陆川",
      "original": "左边壁炉，吧台后厨房，右边上楼。屋子不算小，只是现在能用的地方都挤在这里。",
      "gameLine": 107
    },
    {
      "id": "序-108",
      "actor": "艾莉娅",
      "original": "楼梯第二级和第五级要换。我们只清靠楼梯那间房，其余客房等检查以后再用，今晚也别下酒窖。",
      "gameLine": 108
    },
    {
      "id": "序-109",
      "actor": "旁白",
      "original": "二层走廊绕着挑空大厅连成完整一圈。两人修补踏板，清出一间应急休息处，受潮床褥搬到门边晾着。",
      "gameLine": 109
    },
    {
      "id": "序-110",
      "actor": "陆川",
      "original": "房间先给你吧，我在炉边也能睡。毕竟第一晚就让救我的人坐地上，不太像样。",
      "gameLine": 110
    },
    {
      "id": "序-111",
      "actor": "艾莉娅",
      "original": "床还没干，我也先在炉边。别为了客气，把自己放进另一个不舒服的地方。",
      "gameLine": 111
    },
    {
      "id": "序-112",
      "actor": "陆川",
      "original": "那毯子分一下，你那边靠火，我那边靠桌。你会不会觉得我话太多？",
      "gameLine": 112
    },
    {
      "id": "序-113",
      "actor": "艾莉娅",
      "original": "你紧张的时候说得多，我听出来了。只要搬梁时不分神，不是什么大问题。",
      "gameLine": 113
    },
    {
      "id": "序-114",
      "actor": "陆川",
      "original": "好，那我现在少说一点。今晚发生的事，我可能还得想很久才相信。",
      "gameLine": 114
    },
    {
      "id": "序-115",
      "actor": "艾莉娅",
      "original": "不用今晚都想清。等水烧开，先喝一点，再睡。",
      "gameLine": 115
    },
    {
      "id": "序-116",
      "actor": "陆川",
      "original": "桶里没有新水声了。我刚才醒来的时候，居然先担心是不是把耳朵睡坏了。",
      "gameLine": 116
    },
    {
      "id": "序-117",
      "actor": "艾莉娅",
      "original": "只是补板起作用，外面的雨还没完全停。你看这张清单，屋面、厨房、净水、楼梯和客房，都要继续检查。",
      "gameLine": 117
    },
    {
      "id": "序-118",
      "actor": "陆川",
      "original": "我有一点想把门牌翻成营业，可现在除了能烧水，连菜单都没有。第一份早餐只剩半块面包，确实不值得大声宣布。",
      "gameLine": 118
    },
    {
      "id": "序-119",
      "actor": "艾莉娅",
      "original": "今晚能睡就已经很好了，开店是下一件事。旧门牌写着归灯驿站，你不需要先换名字才能继续修。",
      "gameLine": 119
    },
    {
      "id": "序-120",
      "actor": "陆川",
      "original": "归灯……我喜欢这个名字。早餐先欠着，等厨房能用了，我给你补一顿热的，不算今天这半块。",
      "gameLine": 120
    },
    {
      "id": "序-121",
      "actor": "艾莉娅",
      "original": "那我记下。你别等到忙起来，又说自己忘了答应过什么。",
      "gameLine": 121
    },
    {
      "id": "序-122",
      "actor": "陆川",
      "original": "这事我不忘。至少现在不是我一个人对着一间漏雨的屋子了。",
      "gameLine": 122
    },
    {
      "id": "序-123",
      "actor": "CG字幕",
      "original": "第一盏灯，先照亮了两个避雨的人。",
      "gameLine": 123
    }
  ],
